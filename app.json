{
  "expo": {
    "name": "Teleprompter",
    "slug": "teleprompther",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.teleprompther.app",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "O Teleprompter usa a câmera para gravar seus vídeos.",
          "microphonePermission": "O Teleprompter usa o microfone para gravar o áudio dos seus vídeos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O Teleprompter salva os vídeos gravados na sua galeria.",
          "savePhotosPermission": "O Teleprompter salva os vídeos gravados na sua galeria.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-status-bar"
    ]
  }
}
